# =============================================================================
# x-wal Environment Configuration
# Copy to .env and adjust values for your environment.
# =============================================================================

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=xwal
DB_USER=xwal
DB_PASSWORD=xwal

# --- Keycloak (OAuth2/JWT) ---
KEYCLOAK_JWKS_URL=http://localhost:8083/realms/xwal/protocol/openid-connect/certs
KEYCLOAK_ISSUER=http://localhost:8083/realms/xwal
KEYCLOAK_CLIENT_ID=xwal-api
KEYCLOAK_CLIENT_SECRET=

# --- OpenTelemetry ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
ENVIRONMENT=development

# --- Application ---
# MICRONAUT_SERVER_PORT=8080
# XWAL_CACHE_ENABLED=true
